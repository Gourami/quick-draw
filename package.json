{
  "name": "@stilogik/quick-draw",
  "version": "2.0.0",
  "description": "Tiny first-party WebGL helpers for drawing to an HTML canvas",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "webgl",
    "webgl2",
    "canvas",
    "matrix",
    "vector"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gourami/quick-draw.git"
  },
  "author": "Tyler Dill",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Gourami/quick-draw/issues"
  },
  "homepage": "https://github.com/Gourami/quick-draw#readme",
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
